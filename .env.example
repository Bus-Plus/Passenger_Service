# Example environment file for Passenger_Service
# Copy this to .env and replace values with your local configuration.

DB_URL=jdbc:mysql://localhost:3306/bus_Plus_Passenger_Service
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
SERVER_PORT=3001
JWT_SECRET=your_jwt_secret
WEBHOOK_SECRET=your_webhook_secret
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=../path/to/firebase-service-account.json
AUTH_SERVICE_BASE_URL=http://localhost:3000
